# Gemini API Key (get from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Qdrant Vector DB host
# Options:
# - 'local_db' : saves vectors to local directory inside the project (No Docker or installation needed!)
# - ':memory:' : keeps vectors in RAM (lost when server restarts)
# - 'http://localhost:6333' : connect to local Qdrant running in Docker
# - 'https://xxxxxx.gcp.qdrant.io' : connect to Qdrant Cloud cluster
QDRANT_HOST=local_db
QDRANT_PORT=6333
QDRANT_COLLECTION=chatbot_knowledge

# Models to use
EMBEDDING_MODEL=models/gemini-embedding-001
LLM_MODEL=gemini-2.5-flash
